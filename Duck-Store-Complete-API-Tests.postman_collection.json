  "item": [
    {
      "name": "01 - Inventory CRUD and validation",
      "item": [
        {
          "name": "01 - Create Green XLarge duck",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ducks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ducks"
              ]
            },
            "description": "Creates test inventory. A randomized price reduces the chance of touching an existing inventory row.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"color\": \"Green\",\n  \"size\": \"XLarge\",\n  \"price\": \"{{greenPrice}}\",\n  \"quantity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"greenPrice\")) {",
                  "  const cents = Math.floor(Math.random() * 80000) + 10000;",
                  "  const price = (cents / 100).toFixed(2);",
                  "  pm.collectionVariables.set(\"greenPrice\", price);",
                  "  pm.collectionVariables.set(\"greenUpdatedPrice\", (Number(price) + 1.37).toFixed(2));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Created or accepted inventory row\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const data = pm.response.json();",
                  "pm.expect(data).to.have.property(\"id\");",
                  "pm.expect(data.color).to.eql(\"Green\");",
                  "pm.expect(data.size).to.eql(\"XLarge\");",
                  "pm.collectionVariables.set(\"greenDuckId\", String(data.id));",
                  "pm.collectionVariables.set(\"greenInitialQuantity\", String(data.quantity));",
                  "pm.test(\"Response includes positive price and quantity\", function () {",
                  "  pm.expect(Number(data.price)).to.be.greaterThan(0);",
                  "  pm.expect(data.quantity).to.be.greaterThan(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Merge matching Green XLarge quantity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ducks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ducks"
              ]
            },
            "description": "Checks the atomic merge behavior for the same color, size, and price.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"color\": \"Green\",\n  \"size\": \"XLarge\",\n  \"price\": \"{{greenPrice}}\",\n  \"quantity\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Merge request succeeds\", function () { pm.expect(pm.response.code).to.eql(201); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Same inventory ID is reused\", function () {",
                  "  pm.expect(String(data.id)).to.eql(pm.collectionVariables.get(\"greenDuckId\"));",
                  "});",
                  "pm.test(\"Quantity increased by five\", function () {",
                  "  pm.expect(data.quantity).to.eql(Number(pm.collectionVariables.get(\"greenInitialQuantity\")) + 5);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - List active ducks (quantity sorted)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ducks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ducks"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"List returns 200 and an array\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});",
                  "const rows = pm.response.json();",
                  "pm.test(\"Rows are sorted by quantity ascending (ID as tie-breaker)\", function () {",
                  "  for (let i = 1; i < rows.length; i++) {",
                  "    pm.expect(",
                  "      rows[i-1].quantity < rows[i].quantity ||",
                  "      (rows[i-1].quantity === rows[i].quantity && rows[i-1].id <= rows[i].id)",
                  "    ).to.eql(true);",
                  "  }",
                  "});",
                  "pm.test(\"Created duck is visible\", function () {",
                  "  pm.expect(rows.some(x => String(x.id) === pm.collectionVariables.get(\"greenDuckId\"))).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
