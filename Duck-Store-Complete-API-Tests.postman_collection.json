    {
      "name": "02 - Order pricing and business rules",
      "item": [
        {
          "name": "06 - Order pricing: Land + India + Wood",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"color\": \"Green\",\n  \"size\": \"XLarge\",\n  \"quantity\": 2,\n  \"destinationCountry\": \"India\",\n  \"shippingMode\": \"Land\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const data = pm.response.json();",
                  "pm.expect(data.packageType).to.eql(\"WOOD\");",
                  "pm.expect(data.protectionTypes).to.include(\"Polystyrene balls\");",
                  "pm.expect(data.priceBreakdown.some(x => x.code === \"LAND_SHIPPING\" && Number(x.amount) === 20)).to.eql(true);",
                  "pm.expect(Number(data.totalToPay)).to.be.greaterThan(0);"
                ]
              }
            }
          ]
        },
