                "type": "text/javascript",
                "exec": [
                  "pm.response.to.have.status(200);",
                  "const data = pm.response.json();",
                  "pm.expect(data.priceBreakdown.some(x => x.code === \"AIR_SHIPPING\")).to.eql(true);",
                  "const discount = data.priceBreakdown.find(x => x.code === \"AIR_VOLUME_DISCOUNT\");",
                  "pm.expect(discount).to.exist;",
                  "pm.expect(Number(discount.amount)).to.be.below(0);"
                ]
